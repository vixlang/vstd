pub fn new(): ValueList { return ValueList{ items: [] } }
pub fn len(list: &ValueList): i32 { return list.items.length }
pub fn is_empty(list: &ValueList): bool { return list.items.length == 0 }

pub fn append(list: &ValueList, value: Value) { list.items.push(value) }

pub fn prepend(list: &ValueList, value: Value)
{
    let mut out: [Value] = []
    out.push(value)
    for (i in 0 .. list.items.length) { out.push(list.items[i]) }
    list.items = out
}

pub fn get(list: &ValueList, index: i32): Value { return list.items[index] }

pub fn set(list: &ValueList, index: i32, value: Value)
{
    list.items[index] = value
}

pub fn clear(list: &ValueList) { list.items = [] }
