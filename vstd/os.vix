extern "C"
{
    fn system(command: ptr): i32
    fn getenv(name: ptr): ptr
    fn strdup(s: ptr): string
    fn exit(status: i32): void
}

pub fn run(command: string): i32 { return system(command) }

pub fn env(name: string): Result
{
    let value = getenv(name)
    if (value == 0) return vstd::types::err("environment variable not found: " + name)
    return vstd::types::ok(VStr(strdup(value)))
}

pub fn terminate(status: i32) { exit(status) }
